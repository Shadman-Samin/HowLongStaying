# Copy to .env for local dev (never commit .env). On Vercel, set these in
# Project → Settings → Environment Variables instead.
#
# Upstash Redis (production store). Local dev works without these (JSON file).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# Required in production (server refuses to boot without it).
ADMIN_TOKEN=
#
# Optional: HMAC secret for session tokens. Defaults to ADMIN_TOKEN.
SESSION_SECRET=
